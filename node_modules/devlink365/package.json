{
  "name": "devlink365",
  "version": "0.1.0",
  "description": "Share your localhost with anyone. One command turns a local dev server into a temporary public HTTPS link.",
  "keywords": [
    "tunnel",
    "localhost",
    "ngrok-alternative",
    "https",
    "share",
    "dev-server",
    "reverse-proxy",
    "webhook",
    "preview",
    "developer-tools"
  ],
  "homepage": "https://devlink365.dev",
  "license": "MIT",
  "author": "DevLink365",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "devlink365": "dist/cli.js",
    "devlink365-server": "dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js dist/server.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/unit.test.ts test/tunnel.test.ts",
    "dev:relay": "node --import tsx src/server.ts --port 8787 --domain lvh.me:8787 --scheme http",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
